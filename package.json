{
  "name": "@risleylima/escpos",
  "version": "1.0.2",
  "description": "Node.js thermal printer library: ESC/POS, receipts, barcodes, images via USB or Serial",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Rlima Info",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "yarn build && jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check:ts": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "debug": "^4.4.3",
    "jpeg-js": "^0.4.4",
    "omggif": "^1.0.10",
    "qrcode-generator": "^2.0.4",
    "serialport": "^13.0.0",
    "usb": "^2.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jest": "^30.2.0",
    "typescript": "^5.8.0"
  },
  "directories": {
    "example": "examples"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/risleylima/escpos.git"
  },
  "keywords": [
    "escpos",
    "thermal-printer",
    "receipt-printer",
    "pos",
    "usb",
    "serial",
    "nodejs",
    "barcode",
    "receipt",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/risleylima/escpos/issues"
  },
  "homepage": "https://github.com/risleylima/escpos#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ]
}
